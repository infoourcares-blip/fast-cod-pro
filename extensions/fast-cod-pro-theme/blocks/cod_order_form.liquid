{{ 'fast-cod-pro.css' | asset_url | stylesheet_tag }}
<style>
  body.fast-cod-pro-enabled .shopify-payment-button,
  body.fast-cod-pro-enabled .shopify-payment-button__button,
  body.fast-cod-pro-enabled .product-form__buttons > *:not([data-fast-cod-pro-root]),
  body.fast-cod-pro-enabled product-form button[type='submit']:not(.fast-cod-pro-button),
  body.fast-cod-pro-enabled form[action*='/cart/add'] button[type='submit']:not(.fast-cod-pro-button),
  body.fast-cod-pro-enabled .product-form__submit {
    display: none !important;
  }

  [data-fast-cod-pro-root] {
    --fast-cod-accent: #1d4ed8;
    --fast-cod-header-bg: #111827;
    --fast-cod-header-text: #ffffff;
    --fast-cod-modal-bg: #f8fafc;
    --fast-cod-surface-bg: #ffffff;
    --fast-cod-text: #0f172a;
    --fast-cod-muted: #475569;
    --fast-cod-input-bg: #ffffff;
    --fast-cod-input-text: #111827;
    --fast-cod-input-border: #d7dee8;
    --fast-cod-summary-bg: #eef2f7;
    --fast-cod-primary-bg: #111111;
    --fast-cod-primary-text: #ffffff;
    --fast-cod-radius: 18px;
    display: block;
    width: 100%;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-launcher-card {
    margin: 16px 0;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-launcher {
    width: 100%;
    min-height: 62px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    border: 0;
    border-radius: var(--fast-cod-radius);
    background: var(--fast-cod-launcher-bg, var(--fast-cod-primary-bg));
    color: var(--fast-cod-launcher-text, var(--fast-cod-primary-text));
    font: inherit;
    font-size: 16px;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 14px 28px rgba(15, 23, 42, 0.14);
  }

  [data-fast-cod-pro-root] .fast-cod-pro-launcher--shaker {
    animation: fastCodProLauncherShake 1.4s ease-in-out infinite;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-launcher--bounce {
    animation: fastCodProLauncherBounce 1.5s ease-in-out infinite;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-launcher--pulse {
    animation: fastCodProLauncherPulse 1.6s ease-in-out infinite;
  }

  @keyframes fastCodProLauncherShake {
    0%, 72%, 100% {
      transform: translateX(0);
    }
    78%, 90% {
      transform: translateX(-4px);
    }
    84%, 96% {
      transform: translateX(4px);
    }
  }

  @keyframes fastCodProLauncherBounce {
    0%, 70%, 100% {
      transform: translateY(0);
    }
    82% {
      transform: translateY(-8px);
    }
    92% {
      transform: translateY(-3px);
    }
  }

  @keyframes fastCodProLauncherPulse {
    0%, 70%, 100% {
      transform: scale(1);
      box-shadow: 0 14px 28px rgba(15, 23, 42, 0.14);
    }
    84% {
      transform: scale(1.035);
      box-shadow: 0 18px 34px rgba(15, 23, 42, 0.24);
    }
  }

  [data-fast-cod-pro-root] .fast-cod-pro-modal[hidden] {
    display: none !important;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-modal {
    position: fixed;
    inset: 0;
    z-index: 2147483647;
    padding: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(2, 6, 23, 0.64);
    backdrop-filter: blur(10px);
  }

  [data-fast-cod-pro-root] .fast-cod-pro-sheet {
    position: relative;
    width: min(100%, 760px);
    max-height: calc(100vh - 48px);
    display: flex;
    flex-direction: column;
    overflow: auto;
    background: var(--fast-cod-modal-bg);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 28px;
    box-shadow: 0 32px 90px rgba(2, 6, 23, 0.35);
  }

  [data-fast-cod-pro-root] .fast-cod-pro-sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    position: sticky;
    top: 0;
    z-index: 4;
    min-height: 72px;
    padding: 14px 18px;
    background: var(--fast-cod-header-bg);
    color: var(--fast-cod-header-text);
  }

  [data-fast-cod-pro-root] .fast-cod-pro-sheet-title {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--fast-cod-header-text);
    font-size: 22px;
    font-weight: 900;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-sheet-title-copy {
    display: grid;
    gap: 2px;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-sheet-title-copy strong {
    font-size: 20px;
    line-height: 1.05;
    text-transform: uppercase;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-sheet-title-copy span {
    color: color-mix(in srgb, var(--fast-cod-header-text) 72%, transparent);
    font-size: 12px;
    font-weight: 700;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-home-icon,
  [data-fast-cod-pro-root] .fast-cod-pro-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.12);
    color: var(--fast-cod-header-text);
    font-size: 20px;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-close {
    cursor: pointer;
    font-size: 28px;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-sheet-body {
    display: grid;
    gap: 16px;
    padding: 16px 18px 18px;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-summary-card,
  [data-fast-cod-pro-root] .fast-cod-pro-total-card {
    padding: 16px;
    border-radius: var(--fast-cod-radius);
    border: 1px solid rgba(15, 23, 42, 0.08);
    background: var(--fast-cod-surface-bg);
    box-shadow: 0 14px 36px rgba(15, 23, 42, 0.08);
  }

  [data-fast-cod-pro-root] .fast-cod-pro-summary-row {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-summary-image {
    width: 88px;
    height: 88px;
    object-fit: cover;
    border-radius: 14px;
    background: #f3f4f6;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-summary-meta {
    display: grid;
    gap: 6px;
    color: var(--fast-cod-text);
  }

  [data-fast-cod-pro-root] .fast-cod-pro-summary-eyebrow,
  [data-fast-cod-pro-root] .fast-cod-pro-total-card::before {
    color: var(--fast-cod-accent);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-summary-meta strong {
    font-size: 20px;
    line-height: 1.1;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-qty-control {
    display: inline-grid;
    grid-template-columns: 48px 62px 48px;
    margin-top: 6px;
    border: 1px solid rgba(15, 23, 42, 0.1);
    border-radius: 12px;
    overflow: hidden;
    background: var(--fast-cod-input-bg);
  }

  [data-fast-cod-pro-root] .fast-cod-pro-qty-control button,
  [data-fast-cod-pro-root] .fast-cod-pro-qty-control input {
    min-height: 44px;
    border: 0;
    background: var(--fast-cod-input-bg);
    text-align: center;
    font: inherit;
    font-weight: 800;
    color: var(--fast-cod-input-text);
  }

  [data-fast-cod-pro-root] .fast-cod-pro-total-card {
    background: var(--fast-cod-summary-bg);
  }

  [data-fast-cod-pro-root] .fast-cod-pro-total-card::before {
    content: "Payment overview";
    display: block;
    margin-bottom: 12px;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-total-line {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: var(--fast-cod-text);
    font-size: 16px;
    margin-bottom: 10px;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-total-line--grand {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid rgba(15, 23, 42, 0.08);
    font-size: 20px;
    font-weight: 900;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-grid {
    display: grid;
    gap: 12px;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-form-title {
    margin: 2px 0 4px;
    color: var(--fast-cod-text);
    text-align: center;
    font-size: 24px;
    font-weight: 900;
    line-height: 1.05;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-field {
    display: grid;
    gap: 7px;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-label {
    color: var(--fast-cod-text);
    font-size: 14px;
    font-weight: 700;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-label em {
    color: #dc2626;
    font-style: normal;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-input-wrap {
    position: relative;
    display: block;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-input-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;
    font-size: 16px;
    opacity: 0.7;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-grid input,
  [data-fast-cod-pro-root] .fast-cod-pro-grid textarea,
  [data-fast-cod-pro-root] .fast-cod-pro-grid select {
    width: 100%;
    min-height: 52px;
    padding: 0 16px 0 48px;
    border-radius: 14px;
    border: 1px solid var(--fast-cod-input-border);
    background: var(--fast-cod-input-bg);
    color: var(--fast-cod-input-text);
    font: inherit;
    font-size: 16px;
    box-sizing: border-box;
  }

  [data-fast-cod-pro-root] .fast-cod-pro-button {
    width: 100%;
    min-height: 58px;
    border: 0;
    border-radius: var(--fast-cod-radius);
    background: var(--fast-cod-primary-bg);
    color: var(--fast-cod-primary-text);
    font: inherit;
    font-size: 18px;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 14px 24px rgba(15, 23, 42, 0.16);
  }

  [data-fast-cod-pro-root] .fast-cod-pro-status {
    font-size: 14px;
    font-weight: 800;
  }

  body.fast-cod-pro-modal-open {
    overflow: hidden;
  }

  @media (max-width: 767px) {
    [data-fast-cod-pro-root] .fast-cod-pro-modal {
      padding: 10px;
      align-items: flex-end;
    }

    [data-fast-cod-pro-root] .fast-cod-pro-sheet {
      width: 100%;
      max-height: calc(100vh - 12px);
      border-radius: 24px 24px 12px 12px;
    }

    [data-fast-cod-pro-root] .fast-cod-pro-sheet-body {
      padding: 14px;
    }

    [data-fast-cod-pro-root] .fast-cod-pro-summary-image {
      width: 72px;
      height: 72px;
    }
  }
</style>
<script>
  document.body && document.body.classList.add("fast-cod-pro-enabled");
</script>
{% liquid
  assign fast_cod_product = block.settings.product
  if fast_cod_product == blank
    assign fast_cod_product = product
  endif
  assign fast_cod_variant = fast_cod_product.selected_or_first_available_variant
  assign fast_cod_image = fast_cod_product.featured_image
  assign fast_cod_price_cents = fast_cod_variant.price | default: 0
  assign fast_cod_price_amount = fast_cod_price_cents | divided_by: 100.0
%}
<div
  data-fast-cod-pro-root
  data-accent="{{ block.settings.accent_color }}"
  data-product-title="{{ fast_cod_product.title | escape }}"
  data-product-handle="{{ fast_cod_product.handle }}"
  data-product-image="{{ fast_cod_image | image_url: width: 240 }}"
  data-variant-id="{{ fast_cod_variant.id }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
  data-price="{{ fast_cod_price_amount }}"
  data-price-cents="{{ fast_cod_price_cents }}"
  data-price-display="{{ fast_cod_variant.price | money }}"
  data-stock="{{ fast_cod_variant.inventory_quantity | default: 8 }}"
  data-shop="{{ shop.permanent_domain }}"
  data-config-url="/apps/fast-cod-pro/form-config?product_title={{ fast_cod_product.title | url_encode }}&variant_id={{ fast_cod_variant.id }}&price={{ fast_cod_price_amount }}"
>
  <div class="fast-cod-pro-launcher-card fast-cod-pro-launcher-card--button-only">
    <button class="fast-cod-pro-launcher" type="button" onclick="var root=this.closest('[data-fast-cod-pro-root]');var modal=root&&root.querySelector('.fast-cod-pro-modal');if(modal){modal.hidden=false;document.body.classList.add('fast-cod-pro-modal-open');}return false;">
      <span class="fast-cod-pro-launcher-icon">🛒</span>
      <span class="fast-cod-pro-launcher-label">Order with Fast COD Pro</span>
    </button>
  </div>
  <div class="fast-cod-pro-modal" hidden>
    <div class="fast-cod-pro-backdrop" data-fast-cod-close onclick="var modal=this.closest('.fast-cod-pro-modal');if(modal){modal.hidden=true;document.body.classList.remove('fast-cod-pro-modal-open');}"></div>
    <div class="fast-cod-pro-sheet" role="dialog" aria-modal="true" aria-label="Fast COD Pro order form">
      <div class="fast-cod-pro-sheet-head">
        <div class="fast-cod-pro-sheet-title">
          <span class="fast-cod-pro-home-icon">⌂</span>
          <div class="fast-cod-pro-sheet-title-copy">
            <strong>Fast COD Pro</strong>
            <span>Fast cash-on-delivery checkout</span>
          </div>
        </div>
        <button class="fast-cod-pro-close" type="button" data-fast-cod-close onclick="var modal=this.closest('.fast-cod-pro-modal');if(modal){modal.hidden=true;document.body.classList.remove('fast-cod-pro-modal-open');}">×</button>
      </div>
      <div class="fast-cod-pro-sheet-body">
        <div class="fast-cod-pro-summary-card">
          <div class="fast-cod-pro-summary-row">
            {% if fast_cod_image %}
              {{ fast_cod_image | image_url: width: 240 | image_tag: class: 'fast-cod-pro-summary-image', alt: fast_cod_product.title }}
            {% else %}
              <div class="fast-cod-pro-summary-image fast-cod-pro-summary-image--placeholder"></div>
            {% endif %}
            <div class="fast-cod-pro-summary-meta">
              <span class="fast-cod-pro-summary-eyebrow">Order summary</span>
              <strong class="fast-cod-pro-summary-title">{{ fast_cod_product.title }}</strong>
              <span class="fast-cod-pro-summary-price">{{ fast_cod_variant.price | money }}</span>
              <div class="fast-cod-pro-qty-control">
                <button type="button" data-qty-change="-1">−</button>
                <input name="quantityDisplay" value="1" readonly>
                <button type="button" data-qty-change="1">+</button>
              </div>
            </div>
          </div>
        </div>
        <div class="fast-cod-pro-total-card">
          <div class="fast-cod-pro-total-line"><span>Subtotal</span><strong class="fast-cod-pro-subtotal">{{ fast_cod_variant.price | money }}</strong></div>
          <div class="fast-cod-pro-total-line"><span>Shipping</span><strong>Free</strong></div>
          <div class="fast-cod-pro-total-line fast-cod-pro-total-line--grand"><span>Total</span><strong class="fast-cod-pro-total">{{ fast_cod_variant.price | money }}</strong></div>
        </div>
        <form class="fast-cod-pro-grid" data-fast-cod-form method="post" action="{{ routes.cart_add_url }}">
          <h3 class="fast-cod-pro-form-title">Fast COD Pro order form</h3>
          <label class="fast-cod-pro-field">
            <span class="fast-cod-pro-label">Full name <em>*</em></span>
            <span class="fast-cod-pro-input-wrap">
              <span class="fast-cod-pro-input-icon">👤</span>
              <input name="customerName" type="text" placeholder="Full name" required>
            </span>
          </label>
          <label class="fast-cod-pro-field">
            <span class="fast-cod-pro-label">Phone number <em>*</em></span>
            <span class="fast-cod-pro-input-wrap">
              <span class="fast-cod-pro-input-icon">☎</span>
              <input name="phone" type="tel" placeholder="Phone" required>
            </span>
          </label>
          <label class="fast-cod-pro-field">
            <span class="fast-cod-pro-label">Address <em>*</em></span>
            <span class="fast-cod-pro-input-wrap">
              <span class="fast-cod-pro-input-icon">📍</span>
              <input name="address1" type="text" placeholder="Address" required>
            </span>
          </label>
          <label class="fast-cod-pro-field">
            <span class="fast-cod-pro-label">Pincode <em>*</em></span>
            <span class="fast-cod-pro-input-wrap">
              <span class="fast-cod-pro-input-icon">#</span>
              <input name="pincode" type="text" placeholder="Pincode" required>
            </span>
          </label>
          <label class="fast-cod-pro-field">
            <span class="fast-cod-pro-label">City</span>
            <span class="fast-cod-pro-input-wrap">
              <span class="fast-cod-pro-input-icon">🏙</span>
              <input name="city" type="text" placeholder="City">
            </span>
          </label>
          <input type="hidden" name="quantity" value="1">
          <input type="hidden" name="variantId" value="{{ fast_cod_variant.id }}">
          <input type="hidden" name="productTitle" value="{{ fast_cod_product.title | escape }}">
          <input type="hidden" name="price" value="{{ fast_cod_price_amount }}">
          <input type="hidden" name="shop" value="{{ shop.permanent_domain }}">
          <button class="fast-cod-pro-button" type="button" onclick="return window.FastCodProSubmit?window.FastCodProSubmit(this,event):false">Place Fast COD Pro Order - {{ fast_cod_variant.price | money }}</button>
        </form>
        <div class="fast-cod-pro-status" hidden></div>
      </div>
    </div>
  </div>
</div>
<script src="{{ 'fast-cod-pro.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Fast COD Pro form",
  "target": "section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "autofill": true
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#1d4ed8"
    }
  ]
}
{% endschema %}
